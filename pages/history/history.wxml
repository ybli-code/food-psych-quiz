<view class="page-wrap">
  <view class="lib-hero">
    <view class="title">我的记录</view>
    <view class="subtitle">共 {{list.length}} 份测评报告</view>
  </view>

  <block wx:if="{{list.length > 0}}">
    <view
      wx:for="{{list}}"
      wx:key="id"
      class="card record-item"
      bindtap="goDetail"
      bindlongpress="onDelete"
      data-id="{{item.id}}"
    >
      <view class="record-emoji">{{item.scaleEmoji}}</view>
      <view class="record-info">
        <view class="record-name">{{item.scaleName}}</view>
        <view class="record-date">{{item.date}}</view>
      </view>
      <view class="record-level" style="color: {{item.levelColor}};">
        {{item.levelEmoji}} {{item.levelLabel}}
      </view>
    </view>
    <view class="record-tip">长按记录可删除 · 点击查看报告</view>
  </block>

  <view wx:else class="empty">
    <view class="empty-emoji">🌱</view>
    <view class="empty-title">还没有测评记录</view>
    <view class="empty-sub">去首页选一份量表，开始了解自己吧</view>
    <view class="btn-primary empty-btn" bindtap="goHome">开始第一次测评</view>
  </view>
</view>
