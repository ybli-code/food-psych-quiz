.page-wrap {
  padding: 20rpx 32rpx 64rpx;
}

/* 头部 */
.hero {
  text-align: left;
  padding: 36rpx 8rpx 34rpx;
}
.hero-kicker { color: #CB826C; font-size: 23rpx; font-weight: 600; letter-spacing: 2rpx; }
.hero-title {
  font-size: 43rpx;
  font-weight: 700;
  color: #4A3B33;
  letter-spacing: 1rpx;
  margin-top: 14rpx;
  line-height: 1.35;
}
.hero-sub { font-size: 25rpx; color: #8F8078; margin-top: 12rpx; line-height: 1.6; }
.section-heading { margin: 34rpx 4rpx 18rpx; }
.section-title { color: #4A3B33; font-size: 31rpx; font-weight: 700; }
.section-note { color: #9A8B82; font-size: 23rpx; margin-top: 4rpx; }

/* 今日推荐 */
.recommend {
  background: linear-gradient(140deg, #FFF0E8 0%, #FFE2D3 100%);
  position: relative;
  margin-bottom: 38rpx;
  border: 1rpx solid rgba(232, 162, 132, .18);
  box-shadow: 0 12rpx 34rpx rgba(163, 108, 84, .09);
}
.recommend-tag {
  position: absolute;
  top: 0;
  right: 32rpx;
  background: linear-gradient(135deg, #FF9A76 0%, #F08E6E 100%);
  color: #FFFFFF;
  font-size: 22rpx;
  padding: 8rpx 20rpx;
  border-radius: 0 0 16rpx 16rpx;
}
.recommend-row { display: flex; align-items: flex-start; }
.recommend-emoji { font-size: 64rpx; margin-right: 24rpx; }
.recommend-info { flex: 1; }
.recommend-name { font-size: 32rpx; font-weight: 600; color: #4A3B33; }
.recommend-desc {
  font-size: 24rpx;
  color: #8C7466;
  margin-top: 8rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.recommend-meta { font-size: 22rpx; color: #A8968C; margin-top: 10rpx; }
.recommend-btn { margin-top: 24rpx; }
.btn-arrow { margin-left: 8rpx; font-size: 38rpx; line-height: 28rpx; vertical-align: -2rpx; }

/* 分类滚动条 */
.cat-scroll {
  white-space: nowrap;
  margin: 8rpx 0 24rpx;
}
.cat-scroll .chip { margin-bottom: 8rpx; }

/* 列表 */
.list-heading { color: #4A3B33; font-size: 28rpx; font-weight: 650; margin: 6rpx 4rpx 18rpx; }
.list-count { color: #A8968C; font-size: 22rpx; font-weight: 400; margin-left: 8rpx; }
.scale-item { display: flex; align-items: center; margin-bottom: 24rpx; }
.scale-emoji {
  width: 88rpx;
  height: 88rpx;
  border-radius: 24rpx;
  background: #F8EEE7;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
}
.scale-info { flex: 1; min-width: 0; }
.scale-name { font-size: 30rpx; font-weight: 600; color: #4A3B33; }
.scale-meta { font-size: 22rpx; color: #A8968C; margin-top: 6rpx; }
.scale-arrow { font-size: 40rpx; color: #D9C8BC; margin-left: 12rpx; }
.scale-item:active { background: #FFFAF6; }

.empty-tip {
  text-align: center;
  color: #C4B3A8;
  padding: 60rpx 0;
}

.footer-note { display: flex; flex-direction: column; align-items: center; gap: 6rpx; text-align: center; font-size: 21rpx; line-height: 1.6; color: #A99A91; margin: 30rpx 8rpx 0; padding: 22rpx 18rpx 4rpx; border-top: 1rpx solid #F0E5DC; }
.footer-mark { color: #BA8370; font-size: 22rpx; font-weight: 600; letter-spacing: 2rpx; }
