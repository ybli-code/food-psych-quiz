<view class="page-wrap">
  <!-- 温暖而清晰的入口 -->
  <view class="hero">
    <view class="hero-kicker">给自己一点时间</view>
    <view class="hero-title">今天的你，感觉怎么样？</view>
    <view class="hero-sub">用几分钟了解此刻的状态，不给自己贴标签</view>
  </view>

  <!-- 今日推荐 -->
  <view class="card recommend" bindtap="goQuiz" data-id="{{recommend.id}}">
    <view class="recommend-tag">为你推荐</view>
    <view class="recommend-row">
      <text class="recommend-emoji">{{recommend.emoji}}</text>
      <view class="recommend-info">
        <view class="recommend-name">{{recommend.name}}</view>
        <view class="recommend-desc">{{recommend.desc}}</view>
        <view class="recommend-meta">{{recommend.questions}} 题 · {{recommend.time}}</view>
      </view>
    </view>
    <view class="btn-primary recommend-btn">开始了解自己 <text class="btn-arrow">›</text></view>
  </view>

  <view class="section-heading">
    <view class="section-title">按主题探索</view>
    <view class="section-note">选择你现在最关心的方向</view>
  </view>

  <!-- 分类 -->
  <scroll-view scroll-x class="cat-scroll" enable-flex>
    <view
      wx:for="{{categories}}"
      wx:key="*this"
      class="chip {{catIndex === index ? 'chip-active' : ''}}"
      bindtap="onCatTap"
      data-index="{{index}}"
    >{{item}}</view>
  </scroll-view>

  <!-- 量表列表 -->
  <view class="scale-list">
    <view class="list-heading">全部量表 <text class="list-count">{{filtered.length}} 项</text></view>
    <view
      wx:for="{{filtered}}"
      wx:key="id"
      class="card scale-item"
      bindtap="goQuiz"
      data-id="{{item.id}}"
    >
      <view class="scale-emoji">{{item.emoji}}</view>
      <view class="scale-info">
        <view class="scale-name">{{item.name}}</view>
        <view class="scale-meta">{{item.category}} · {{item.questions}} 题 · {{item.time}}</view>
      </view>
      <view class="scale-arrow">›</view>
    </view>
    <view wx:if="{{filtered.length === 0}}" class="empty-tip">该分类暂无量表 🌱</view>
  </view>

  <view class="footer-note"><text class="footer-mark">心晴测</text><text>测评结果仅供自我了解，不能替代专业诊断</text></view>
</view>
