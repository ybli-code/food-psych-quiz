.page-wrap { padding: 32rpx 32rpx 60rpx; }

.lib-hero { padding: 24rpx 8rpx 30rpx; }
.eyebrow { color: #CB826C; font-size: 22rpx; font-weight: 600; margin-bottom: 8rpx; }
.lib-hero .title { font-size: 44rpx; letter-spacing: 1rpx; }
.lib-hero .subtitle { line-height: 1.55; margin-top: 8rpx; }
.list-heading { font-size: 28rpx; color: #4A3B33; font-weight: 650; margin: 4rpx 4rpx 18rpx; }

.cat-scroll { white-space: nowrap; margin-bottom: 28rpx; }
.cat-scroll .chip { margin-bottom: 8rpx; }

.scale-item { display: flex; align-items: flex-start; margin-bottom: 20rpx; padding: 28rpx; box-shadow: 0 4rpx 18rpx rgba(140, 102, 79, .07); }
.scale-emoji {
  width: 88rpx;
  height: 88rpx;
  border-radius: 24rpx;
  background: #F8EEE7;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
}
.scale-info { flex: 1; min-width: 0; }
.scale-name { font-size: 30rpx; font-weight: 600; color: #4A3B33; }
.scale-desc { font-size: 23rpx; color: #857970; margin-top: 8rpx; line-height: 1.55; }
.scale-meta { font-size: 22rpx; color: #B9A79C; margin-top: 14rpx; display: flex; align-items: center; }
.cat-badge {
  background: #FFE8DC;
  color: #E8845C;
  border-radius: 16rpx;
  padding: 2rpx 16rpx;
  margin-right: 16rpx;
}
.library-note { color: #9A8B82; font-size: 21rpx; line-height: 1.65; text-align: center; margin: 30rpx 12rpx 4rpx; padding-top: 20rpx; border-top: 1rpx solid #F0E5DC; }
.empty-tip { text-align: center; color: #C4B3A8; padding: 60rpx 0; }

.seo-line {
  text-align: center;
  font-size: 22rpx;
  color: #C4B3A8;
  margin-top: 24rpx;
  line-height: 1.8;
}
