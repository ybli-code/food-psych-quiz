.page-wrap { padding: 32rpx 32rpx 60rpx; }

/* 结果头图 */
.result-hero {
  border-radius: 32rpx;
  padding: 52rpx 32rpx 40rpx;
  text-align: center;
  margin-bottom: 24rpx;
}
.result-emoji { font-size: 88rpx; }
.result-level { font-size: 40rpx; font-weight: 700; color: #4A3B33; margin-top: 12rpx; }
.result-total { font-size: 30rpx; color: #7A6558; margin-top: 8rpx; }
.result-range { font-size: 22rpx; color: #A8968C; }
.result-date { font-size: 22rpx; color: #A8968C; margin-top: 10rpx; }

/* 量表信息 */
.result-scale {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
  padding: 24rpx 32rpx;
}
.result-scale-emoji { font-size: 40rpx; margin-right: 16rpx; }
.result-scale-name { flex: 1; font-size: 28rpx; font-weight: 600; color: #4A3B33; }
.scale-arrow { font-size: 36rpx; color: #D9C8BC; }

/* 区块 */
.section { margin-bottom: 24rpx; }
.section-title { font-size: 30rpx; font-weight: 600; color: #4A3B33; margin-bottom: 16rpx; }
.section-body { font-size: 27rpx; color: #7A6558; }
.note-body { font-size: 24rpx; color: #A8968C; }

/* 维度条 */
.factor { margin-bottom: 26rpx; }
.factor:last-child { margin-bottom: 0; }
.factor-head {
  display: flex;
  justify-content: space-between;
  margin-bottom: 10rpx;
}
.factor-name { font-size: 26rpx; color: #5B4A43; }
.factor-score { font-size: 26rpx; color: #F08E6E; font-weight: 600; }
.factor-bar-bg {
  height: 14rpx;
  background: #F7EDE3;
  border-radius: 10rpx;
  overflow: hidden;
}
.factor-bar {
  height: 100%;
  background: linear-gradient(90deg, #FFB88C 0%, #F08E6E 100%);
  border-radius: 10rpx;
}
.factor-text { font-size: 23rpx; color: #A8968C; margin-top: 8rpx; }

/* 免责声明 */
.disclaimer {
  font-size: 22rpx;
  color: #C4B3A8;
  text-align: center;
  padding: 16rpx 20rpx 24rpx;
}

/* 按钮 */
.result-actions { display: flex; margin-top: 8rpx; }
.action-half { flex: 1; }
.action-half:first-child { margin-right: 20rpx; }
